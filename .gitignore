# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.cache/
.pytest_cache/
.pytype/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
poetry.lock

# Other
*.DS_Store
.idea

# Ignore generated docs
docs/_build
docs/api

# Don't commit data or databases
data/
databases/

# Allow tracking files in .agents (e.g., skills references)
!.agents/

# Force track .python-version
!.python-version
